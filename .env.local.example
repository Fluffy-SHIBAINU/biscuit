# Biscuit settings. Copy to .env.local and fill the blanks. Never commit .env.local.

# Meta Model API (api.meta.ai). The key lives on the API server only.
MODEL_API_KEY=
# The second reader, served per token by Fireworks: DeepSeek V4.1 Flash unless FIREWORKS_READER_MODEL names another model
# (accounts/fireworks/models/muse-spark-open is Meta's open weights; it reasons on every call and misses the 10-second budget).
# Every letter is read by both readers and Biscuit speaks only what both read the same way. READER_SECOND=fireworks turns it
# on; off reads once with Meta.
FIREWORKS_API_KEY=
FIREWORKS_READER_MODEL=
READER_SECOND=off
# Baseten, unused for now (kept for a later private lane).
BASETEN_API_KEY=

# Postgres. Production: Neon, added from the Vercel Marketplace, which sets DATABASE_URL in Vercel env.
# Local: a Docker container (scripts/db-local.sh), nothing shared with anything.
DATABASE_URL=postgres://postgres:biscuit@127.0.0.1:5433/biscuit

PUBLIC_BASE_URL=https://biscuit.kindred-ai.dev

# Biscuit's neural voice, optional. TTS_URL names a text-to-speech endpoint and TTS_PROVIDER its shape: "kokoro" (a Baseten Kokoro
# predict URL) or "openai" (OpenAI's /v1/audio/speech shape: what VoiceStudio on the founder's Mac speaks behind an ngrok tunnel;
# scripts/voice/tunnel.sh starts both and prints these lines). TTS_API_KEY signs with Bearer or Api-Key; TTS_BASIC_AUTH ("user:pass")
# signs the tunnel instead. Without TTS_URL, or when the call fails, the phone's own voice speaks.
TTS_URL=
TTS_PROVIDER=kokoro
TTS_MODEL=
TTS_API_KEY=
TTS_BASIC_AUTH=
TTS_VOICE=am_michael
TTS_SPEED=1.0

# Web push identity. Generate once: node scripts/vapid.mjs >> .env.local
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@kindred-ai.dev

# The delivery-hour chime tick: POST /api/biscuit/chime/tick with "Authorization: Bearer <CRON_SECRET>". The same value
# is the repository's Actions secret CRON_SECRET; .github/workflows/chime.yml calls the tick every ten minutes.
# Generate one: openssl rand -hex 24
CRON_SECRET=

# Kindred products Biscuit talks to.
WAIVE_BASE_URL=https://waive.kindred-ai.dev
ID_ISSUER=https://id.kindred-ai.dev
# Local only: an email that stands in for the Kindred session cookie.
KINDRED_AUTH_BYPASS=
